# WhatsApp Business API (Meta)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WHATSAPP_VERIFY_TOKEN=choose_any_secret_word

# URL of this server (use ngrok URL when running locally)
BASE_URL=http://localhost:8000

# Personal task/note assistant in WhatsApp is available only to the phone
# configured as admin_phone in the dashboard settings.
# Examples: "משימה: להתקשר לספק", "הערה: לדבר עם יוסי", "משימות", "בוצע 1".
# Set QUOTE_TEMPLATE_PATH only if the quote_template.docx file is stored elsewhere.
# QUOTE_TEMPLATE_PATH=C:\path\to\quote_template.docx

# Time to send daily messages (24h format, Israel time)
DAILY_MESSAGE_HOUR=14
DAILY_MESSAGE_MINUTE=0
